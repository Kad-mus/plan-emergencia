rules_version = '2';

// Reglas de seguridad de Firestore para el Plan de Emergencia.
// Pégalas en: Consola de Firebase → Firestore Database → Reglas → Publicar.
//
// IMPORTANTE: sustituye los correos de ejemplo por los de las personas de casa.
// Solo esos usuarios (que además deben existir en Authentication) podrán leer
// y modificar el plan. Cualquier otra cuenta recibe "Usuario no autorizado".
//
// Si el repositorio de GitHub es público, NO subas este archivo con los correos
// reales: edítalos solo en la consola de Firebase.

service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'persona1@ejemplo.com',
          'persona2@ejemplo.com',
          'persona3@ejemplo.com'
        ];
    }

    match /planes/{planId} {
      allow read, write: if autorizado();
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
